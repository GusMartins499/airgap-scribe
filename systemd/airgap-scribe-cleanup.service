[Unit]
Description=Remove work data of airgap-scribe drafts whose pull request was merged

[Service]
Type=oneshot
EnvironmentFile=%h/.config/airgap-scribe/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/airgap-scribe cleanup --config %h/.config/airgap-scribe/pipeline.toml
